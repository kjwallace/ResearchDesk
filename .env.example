# Copy to .env and fill in. .env is never committed; keys are never printed or logged.

# Every generative model call goes through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jev (stage 3 classification) through the TypeSafe SDK; OpenRouter does not serve it.
TYPESAFE_API_KEY=

# Model IDs. Code defines none of these; each is read from here.
JEV_MODEL=jev-1.13.0
ANALYSIS_MODEL=anthropic/claude-sonnet-5.5
NOTES_MODEL=anthropic/claude-haiku-4.5
# Hugging Face repo ID, pulled from the Hub and run locally.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: a Hugging Face token raises Hub download rate limits.
# HF_TOKEN=

# Directory the web app reads stage files from.
TRIAGE_DATA_DIR=data/out/day_1
